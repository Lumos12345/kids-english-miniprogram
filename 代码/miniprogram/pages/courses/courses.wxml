<!-- pages/courses/courses.wxml -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input class="search-input" 
             placeholder="搜索课程..." 
             value="{{searchKeyword}}"
             bindinput="onSearchInput"
             confirm-type="search"
             bindconfirm="onSearch"/>
    </view>
    <view class="filter-btn" bindtap="showFilterModal">
      <text class="filter-icon">🔽</text>
      <text>筛选</text>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x>
    <view class="category-list">
      <view class="category-item {{selectedCategory === 0 ? 'active' : ''}}" 
            bindtap="selectCategory" data-id="0">
        <text>全部</text>
      </view>
      <view class="category-item {{selectedCategory === item.category_id ? 'active' : ''}}" 
            wx:for="{{categories}}" 
            wx:key="category_id"
            bindtap="selectCategory" 
            data-id="{{item.category_id}}">
        <text>{{item.category_name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 课程列表 -->
  <view class="course-list">
    <view class="course-card" 
          wx:for="{{courses}}" 
          wx:key="course_id"
          bindtap="navigateToDetail" 
          data-id="{{item.course_id}}">
      <view class="course-cover">
        <image class="cover-image" src="{{item.cover_image}}" mode="aspectFill"></image>
        <view class="course-level">{{item.level_text}}</view>
        <view class="course-free" wx:if="{{item.is_free}}">免费</view>
      </view>
      
      <view class="course-info">
        <text class="course-name">{{item.course_name}}</text>
        <text class="course-desc">{{item.description}}</text>
        
        <view class="course-meta">
          <view class="meta-item">
            <text class="meta-icon">👨‍🏫</text>
            <text class="meta-text">{{item.teacher_name}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">⏱️</text>
            <text class="meta-text">{{item.duration}}分钟</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">📚</text>
            <text class="meta-text">{{item.total_lessons}}课时</text>
          </view>
        </view>
        
        <view class="course-stats">
          <view class="stat-item">
            <text class="stat-value">⭐ {{item.rating}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">{{item.enroll_count}}人学习</text>
          </view>
          <view class="stat-item price">
            <text class="stat-value">{{item.is_free ? '免费' : '¥' + item.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <button class="load-more-btn" bindtap="loadMore" loading="{{loading}}">
      {{loading ? '加载中...' : '加载更多'}}
    </button>
  </view>
  
  <view class="no-more" wx:if="{{!hasMore && courses.length > 0}}">
    <text>没有更多课程了</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{courses.length === 0 && !loading}}">
    <text class="empty-icon">📚</text>
    <text class="empty-text">暂无课程</text>
    <text class="empty-desc">换个关键词试试吧</text>
  </view>

  <!-- 筛选模态框 -->
  <view class="modal {{showFilter ? 'show' : ''}}" bindtap="hideFilterModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">课程筛选</text>
        <text class="modal-close" bindtap="hideFilterModal">✕</text>
      </view>
      
      <view class="filter-section">
        <text class="filter-section-title">难度级别</text>
        <view class="filter-options">
          <view class="filter-option {{filterLevel === '' ? 'active' : ''}}" 
                bindtap="selectLevel" data-level="">
            <text>全部</text>
          </view>
          <view class="filter-option {{filterLevel === 'beginner' ? 'active' : ''}}" 
                bindtap="selectLevel" data-level="beginner">
            <text>入门</text>
          </view>
          <view class="filter-option {{filterLevel === 'elementary' ? 'active' : ''}}" 
                bindtap="selectLevel" data-level="elementary">
            <text>初级</text>
          </view>
          <view class="filter-option {{filterLevel === 'intermediate' ? 'active' : ''}}" 
                bindtap="selectLevel" data-level="intermediate">
            <text>中级</text>
          </view>
          <view class="filter-option {{filterLevel === 'advanced' ? 'active' : ''}}" 
                bindtap="selectLevel" data-level="advanced">
            <text>高级</text>
          </view>
        </view>
      </view>
      
      <view class="filter-section">
        <text class="filter-section-title">价格类型</text>
        <view class="filter-options">
          <view class="filter-option {{filterPrice === '' ? 'active' : ''}}" 
                bindtap="selectPrice" data-price="">
            <text>全部</text>
          </view>
          <view class="filter-option {{filterPrice === 'free' ? 'active' : ''}}" 
                bindtap="selectPrice" data-price="free">
            <text>免费</text>
          </view>
          <view class="filter-option {{filterPrice === 'paid' ? 'active' : ''}}" 
                bindtap="selectPrice" data-price="paid">
            <text>付费</text>
          </view>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-reset" bindtap="resetFilter">重置</button>
        <button class="btn-confirm" bindtap="applyFilter">确定</button>
      </view>
    </view>
  </view>
</view>