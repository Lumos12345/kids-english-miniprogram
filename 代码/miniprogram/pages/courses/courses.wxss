/* pages/courses/courses.wxss */
.container {
  padding-bottom: 20rpx;
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: white;
  gap: 20rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 30rpx;
  padding: 15rpx 25rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 15rpx 25rpx;
  background-color: #F5F5F5;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.filter-icon {
  font-size: 28rpx;
}

/* 分类标签样式 */
.category-scroll {
  white-space: nowrap;
  padding: 20rpx 0;
  background-color: white;
  border-bottom: 1rpx solid #E8E8E8;
}

.category-list {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 20rpx;
}

.category-item {
  padding: 12rpx 30rpx;
  background-color: #F5F5F5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
}

/* 课程列表样式 */
.course-list {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.course-card {
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s ease;
}

.course-card:active {
  transform: scale(0.98);
}

.course-cover {
  position: relative;
  height: 320rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.course-level {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 16rpx;
  background-color: rgba(74, 144, 226, 0.9);
  color: white;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.course-free {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 16rpx;
  background-color: #52C41A;
  color: white;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.course-info {
  padding: 25rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.course-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666;
}

.course-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8E8E8;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

.stat-value {
  font-size: 26rpx;
  color: #333;
}

.stat-item.price .stat-value {
  color: #FF4D4F;
  font-size: 32rpx;
  font-weight: bold;
}

/* 加载更多样式 */
.load-more {
  padding: 30rpx 20rpx;
  text-align: center;
}

.load-more-btn {
  background-color: #F5F5F5;
  color: #666;
  border-radius: 30rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  border: none;
}

.no-more {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 空状态样式 */
.empty-state {
  padding: 100rpx 20rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  display: block;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #E8E8E8;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.filter-section {
  padding: 30rpx;
  border-bottom: 1rpx solid #E8E8E8;
}

.filter-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-option {
  padding: 15rpx 30rpx;
  background-color: #F5F5F5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-option.active {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
}

.btn-reset,
.btn-confirm {
  flex: 1;
  padding: 25rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  border: none;
}

.btn-reset {
  background-color: #F5F5F5;
  color: #666;
}

.btn-confirm {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
}