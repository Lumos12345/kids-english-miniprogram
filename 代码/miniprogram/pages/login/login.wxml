<!-- pages/login/login.wxml -->
<view class="container">
  <view class="login-header">
    <view class="logo">
      <text class="logo-icon">📚</text>
      <text class="logo-text">少儿英语辅导</text>
    </view>
    <text class="login-subtitle">让英语学习更有趣</text>
  </view>

  <view class="login-form">
    <!-- 用户类型选择 -->
    <view class="form-group">
      <text class="label">用户类型</text>
      <view class="type-selector">
        <view class="type-item {{userType === 'student' ? 'active' : ''}}" 
              bindtap="selectUserType" data-type="student">
          <text class="type-icon">👦</text>
          <text class="type-name">学生</text>
        </view>
        <view class="type-item {{userType === 'parent' ? 'active' : ''}}" 
              bindtap="selectUserType" data-type="parent">
          <text class="type-icon">👨‍👩‍👧</text>
          <text class="type-name">家长</text>
        </view>
        <view class="type-item {{userType === 'teacher' ? 'active' : ''}}" 
              bindtap="selectUserType" data-type="teacher">
          <text class="type-icon">👩‍🏫</text>
          <text class="type-name">教师</text>
        </view>
      </view>
    </view>

    <!-- 登录表单 -->
    <view class="form-group">
      <text class="label">用户名/手机号</text>
      <input class="input" 
             placeholder="请输入用户名或手机号" 
             value="{{username}}"
             bindinput="onUsernameInput"
             placeholder-class="placeholder"/>
    </view>

    <view class="form-group">
      <text class="label">密码</text>
      <view class="password-input">
        <input class="input" 
               placeholder="请输入密码" 
               password="{{!showPassword}}"
               value="{{password}}"
               bindinput="onPasswordInput"
               placeholder-class="placeholder"/>
        <text class="password-toggle" bindtap="togglePassword">
          {{showPassword ? '👁️' : '🔒'}}
        </text>
      </view>
    </view>

    <!-- 记住密码和忘记密码 -->
    <view class="form-options">
      <view class="checkbox-group" bindtap="toggleRemember">
        <view class="checkbox {{rememberMe ? 'checked' : ''}}">
          <text wx:if="{{rememberMe}}">✓</text>
        </view>
        <text class="checkbox-label">记住密码</text>
      </view>
      <text class="forgot-password" bindtap="forgotPassword">忘记密码？</text>
    </view>

    <!-- 登录按钮 -->
    <button class="login-btn" 
            bindtap="handleLogin" 
            loading="{{loading}}"
            disabled="{{loading}}">
      {{loading ? '登录中...' : '登录'}}
    </button>

    <!-- 注册链接 -->
    <view class="register-link">
      <text>还没有账号？</text>
      <text class="register-text" bindtap="goToRegister">立即注册</text>
    </view>
  </view>

  <!-- 其他登录方式 -->
  <view class="other-login">
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="divider-line"></view>
    </view>
    
    <view class="social-login">
      <view class="social-item" bindtap="wechatLogin">
        <text class="social-icon">💬</text>
        <text class="social-text">微信登录</text>
      </view>
    </view>
  </view>

  <!-- 用户协议 -->
  <view class="agreement">
    <text class="agreement-text">登录即表示同意</text>
    <text class="agreement-link">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link">《隐私政策》</text>
  </view>
</view>