/**app.wxss**/
page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  font-size: 16px;
  line-height: 1.5;
}

/* 容器 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
  border-radius: 50rpx;
  padding: 25rpx 40rpx;
  font-size: 32rpx;
  border: none;
}

.btn-secondary {
  background-color: #F0F0F0;
  color: #333;
  border-radius: 50rpx;
  padding: 25rpx 40rpx;
  font-size: 32rpx;
  border: none;
}

.btn-success {
  background: linear-gradient(135deg, #52C41A 0%, #389E0D 100%);
  color: white;
  border-radius: 50rpx;
  padding: 25rpx 40rpx;
  font-size: 32rpx;
  border: none;
}

/* 输入框样式 */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.input-field {
  background-color: #F9F9F9;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  padding: 25rpx;
  font-size: 30rpx;
}

.input-field:focus {
  border-color: #4A90E2;
}

/* 文本样式 */
.text-primary {
  color: #4A90E2;
}

.text-success {
  color: #52C41A;
}

.text-warning {
  color: #FAAD14;
}

.text-danger {
  color: #FF4D4F;
}

.text-muted {
  color: #999;
}

/* 标题样式 */
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 15rpx;
}

/* 列表样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #E8E8E8;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #4A90E2;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.list-item-desc {
  font-size: 24rpx;
  color: #999;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-primary {
  background-color: #E6F7FF;
  color: #1890FF;
  border: 1rpx solid #91D5FF;
}

.tag-success {
  background-color: #F6FFED;
  color: #52C41A;
  border: 1rpx solid #B7EB8F;
}

.tag-warning {
  background-color: #FFFBE6;
  color: #FAAD14;
  border: 1rpx solid #FFE58F;
}

/* 网格布局 */
.grid {
  display: grid;
  gap: 20rpx;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

/* 进度条 */
.progress-bar {
  height: 8rpx;
  background-color: #E8E8E8;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2 0%, #357ABD 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #E8E8E8;
  margin: 30rpx 0;
}